# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW=elec2-stream
KAFKA_CONSUMER_GROUP=qml-streaming-worker-group

# Stream Pacing & Window Parameters
PRODUCER_DELAY_MS=25
INITIAL_WARMUP_WINDOW=200
SLIDING_WINDOW_SIZE=100
ROLLING_METRIC_WINDOW=100
RANDOM_SEED=42

# Quantum Model Hyperparameters
NUM_QUBITS=5
VQC_ANSATZ_REPS=2
VQC_INITIAL_SPSA_STEPS=40
VQC_ADAPT_SPSA_STEPS=10
VQC_SPSA_LR=0.15
VQC_SPSA_PERTURBATION=0.10
# Drift fine-tuning knobs (0 = full-window loss; see PLAN.md Sec. 11)
VQC_ADAPT_LR_SCALE=0.75
VQC_ADAPT_BATCH_SIZE=0
# Readout observable: 'parity' (Z^{\otimes 5}) or 'z0'
VQC_READOUT=parity
QSVM_MAX_SUPPORT_SIZE=80
QSVM_REPLACE_RATIO=0.20
QSVM_C=1.0

# Classical RBF control (M7/M8)
RBF_C=1.0
RBF_GAMMA=scale

# ADWIN Drift Detection
ADWIN_DELTA=0.002

# Drift recovery metric definition (see PLAN.md Sec. 5)
RECOVERY_EPSILON=0.02
RECOVERY_SUSTAIN_EVENTS=20
RECOVERY_HORIZON=300

# InfluxDB v2 Telemetry Sink
# REQUIRED when INFLUXDB_ENABLED=true. Generate strong values, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=ioe413-org
INFLUXDB_BUCKET=streaming_quantum
INFLUXDB_ENABLED=true

# Docker infrastructure credentials (docker-compose.yml)
INFLUXDB_ADMIN_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Logging
LOG_LEVEL=INFO
